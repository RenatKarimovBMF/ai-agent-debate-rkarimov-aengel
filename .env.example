# Copy to .env and fill in (never commit .env)

# --- FREE (recommended): Google Gemini ---
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy-your-key-here
# LLM_PROVIDER=gemini

# --- Optional: paid Anthropic API ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: Claude CLI (login, no API key) ---
# LLM_PROVIDER=claude_cli

# Optional: path to claude CLI if not on PATH
# CLAUDE_CLI_PATH=claude

# Budget guard (Gatekeeper)
MAX_TOTAL_REQUESTS=200
MAX_REQUESTS_PER_AGENT=80
